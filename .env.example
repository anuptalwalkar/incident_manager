# Recall Bot: Bot User OAuth Token (xoxb-) and app-level token (xapp-, scope connections:write)
RECALL_BOT_TOKEN=
RECALL_APP_TOKEN=
# Naive Bot
NAIVE_BOT_TOKEN=
NAIVE_APP_TOKEN=
# Incident Replay (bot token only, no Socket Mode)
REPLAY_BOT_TOKEN=
SLACK_CHANNEL=inc-checkout-latency
OPENROUTER_API_KEY=
# Without OPENROUTER_API_KEY the OpenAI API is used
OPENAI_API_KEY=
# LLM_MODEL=openai/gpt-4.1-mini
# EMBED_MODEL=openai/text-embedding-3-small
# NAIVE_K=10
# naive-bot storage in Neo4j (leave NEO4J_URI empty to keep it in memory)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
