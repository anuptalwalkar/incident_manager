# Recall Bot: Bot User OAuth Token (xoxb-) and app-level token (xapp-, scope connections:write)
RECALL_BOT_TOKEN=
RECALL_APP_TOKEN=
# Naive Bot
NAIVE_BOT_TOKEN=
NAIVE_APP_TOKEN=
# Incident Replay (bot token only, no Socket Mode)
REPLAY_BOT_TOKEN=
SLACK_CHANNEL=inc-checkout-latency
OPENROUTER_API_KEY=
# Without OPENROUTER_API_KEY the OpenAI API is used
OPENAI_API_KEY=
# LLM_MODEL=openai/gpt-4.1-mini
# EMBED_MODEL=openai/text-embedding-3-small
# JUDGE_MODEL=openai/gpt-4.1
# NAIVE_K=10
# naive-bot storage: NAIVE_BACKEND=mem0 runs it on Mem0 (local, under data/mem0),
# reading raw messages and doing its own updates; MEM0_INFER=0 stores the extractor's notes as they are
# NAIVE_BACKEND=mem0
# MEM0_INFER=1
# Otherwise Neo4j (leave NEO4J_URI empty to keep it in memory)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
